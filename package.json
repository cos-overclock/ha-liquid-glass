{
  "name": "ha-liquid-glass",
  "version": "0.8.0",
  "description": "Liquid Glass style Lovelace cards for Home Assistant",
  "license": "MIT",
  "type": "module",
  "main": "dist/liquid-glass-cards.js",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "watch": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "demo": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "@samasante/liquid-glass": "^0.1.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "preact-render-to-string": "^6.7.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
